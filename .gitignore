node_modules/
# Build output stays out of Git; release tarballs carry it. The UI copy is kept
# because `packages/ui/lib` also matches `lib/`. The vendored host under
# `vendor/` is generated by scripts/bundle-deps.mjs, not source.
lib/
!packages/ui/lib/
/vendor/@deepseek-ai/
/vendor/node-addon-require-builtin/
/vendor/loader.mjs
/vendor/loader.d.mts
*.tsbuildinfo
.dsh/
